<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <title>404 — Story Not Found | Blogify</title>
</head>
<body>
  <%- include('./partials/nav') %>

  <main class="app-main d-flex align-items-center justify-content-center py-5">
    <div class="container text-center py-5">
      <div class="brand-icon mx-auto mb-4" style="width: 64px; height: 64px; font-size: 1.8rem;">
        <i class="bi bi-compass"></i>
      </div>
      <h1 class="display-1 fw-bold text-gradient mb-2">404</h1>
      <h2 class="h3 fw-bold text-white mb-3">Story or Page Not Found</h2>
      <p class="text-secondary mx-auto mb-4" style="max-width: 480px;">
        The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
      </p>
      <div class="d-flex justify-content-center gap-3">
        <a href="/" class="btn-primary-custom" style="width: auto;">
          <i class="bi bi-house-door-fill"></i> Return Home
        </a>
        <a href="/blog/add-new" class="btn-secondary-custom">
          <i class="bi bi-pen"></i> Write Story
        </a>
      </div>
    </div>
  </main>

  <%- include('./partials/script') %>
</body>
</html>
