<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <title>Sign In — Blogify</title>
</head>
<body>
  <%- include('./partials/nav') %>

  <main class="app-main">
    <div class="auth-wrapper">
      <div class="auth-card">
        <div class="auth-header">
          <div class="brand-icon mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.4rem;">
            <i class="bi bi-feather"></i>
          </div>
          <h1 class="auth-title">Welcome Back</h1>
          <p class="auth-subtitle">Sign in to your account to write stories and participate in community discussions.</p>
        </div>

        <% if (locals.error) { %>
          <div class="alert-custom-danger mb-4 mt-0">
            <i class="bi bi-exclamation-circle-fill"></i>
            <div><%= locals.error %></div>
          </div>
        <% } %>

        <% if (locals.success) { %>
          <div class="alert-custom-success mb-4 mt-0">
            <i class="bi bi-check-circle-fill"></i>
            <div><%= locals.success %></div>
          </div>
        <% } %>

        <form action="/user/signin" method="POST">
          <!-- Email Address -->
          <div class="mb-3">
            <label for="email" class="form-label-custom">Email Address</label>
            <div class="input-with-icon">
              <i class="bi bi-envelope-fill input-icon-left"></i>
              <input 
                type="email" 
                class="form-input-custom" 
                id="email" 
                name="email" 
                value="<%= locals.email || '' %>"
                placeholder="name@example.com" 
                required 
                autofocus
              >
            </div>
          </div>

          <!-- Password -->
          <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <label for="password" class="form-label-custom mb-0">Password</label>
            </div>
            <div class="input-with-icon">
              <i class="bi bi-lock-fill input-icon-left"></i>
              <input 
                type="password" 
                class="form-input-custom" 
                id="password" 
                name="password" 
                placeholder="Enter your password" 
                required
              >
              <button type="button" class="password-toggle-btn" data-target="password" aria-label="Toggle password visibility">
                <i class="bi bi-eye"></i>
              </button>
            </div>
          </div>

          <!-- Submit -->
          <button type="submit" class="btn-primary-custom mb-3">
            <i class="bi bi-box-arrow-in-right"></i>
            <span>Sign In</span>
          </button>
        </form>

        <div class="text-center mt-3 pt-3 border-top border-secondary-subtle">
          <p class="text-secondary small mb-0">
            Don't have an account yet? 
            <a href="/user/signup" class="text-white fw-semibold text-decoration-underline ms-1">Create an account</a>
          </p>
        </div>
      </div>
    </div>
  </main>

  <%- include('./partials/script') %>
</body>
</html>